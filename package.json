{
  "name": "owencode",
  "version": "0.1.0",
  "description": "opencode extensions by owenewans",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "owencode-browser": "./dist/browser/server.js"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "browser:fetch": "camoufox-js fetch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "ssh",
    "github",
    "plugin",
    "remote-development"
  ],
  "author": "owenewans <owenewans@owenewans.org>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenewans/owencode.git"
  },
  "homepage": "https://github.com/owenewans/owencode#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/plugin": "^1.18.15",
    "@playwright/mcp": "0.0.79",
    "camoufox-js": "0.12.0",
    "diff": "^9.0.0",
    "playwright-core": "1.60.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
